# Copy to apps/api/.env (gitignored):
#   cp apps/api/.env.example apps/api/.env
#
# The credentials here must match infra/.env, which is what actually
# initialises the Postgres container. Full local setup from a fresh clone:
#
#   1. cp infra/.env.example infra/.env       # then edit POSTGRES_PASSWORD
#   2. cp apps/api/.env.example apps/api/.env # set the same password below
#   3. docker compose -f infra/docker-compose.yml up -d
#   4. cd apps/api && bun run db:migrate
#   5. bun test                               # also works from the repo root
#
# If you change POSTGRES_PASSWORD after the volume already exists, Postgres
# will NOT pick it up — credentials are only applied on first initialisation.
# Recreate the volume (destroys local data) with:
#   docker compose -f infra/docker-compose.yml down -v
DATABASE_URL=postgres://diudara:change_me@localhost:5432/diudara
PORT=3000

# Signing secret for creator session JWTs. Generate your own:
#   openssl rand -base64 32
# The API refuses to start if this is unset, shorter than 32 characters, or
# still the placeholder value below — every creator session depends on this one
# key, and a weak HS256 secret is brute-forceable offline from a single token.
JWT_SECRET=change_me_to_a_long_random_string

# Xendit. Unset outside production selects the fake payment adapter (all tests do).
# In production, bootstrap() THROWS unless these are set — a misconfigured
# production box must not silently take fake payments and write fake-acct-* ids
# into creator.xendit_account_id, which cannot be undone without manual SQL.
# Partial configuration (one set, the other unset) throws in EVERY environment:
# it is never intentional, and it makes an operator believe payments are live.
# XENDIT_SECRET_KEY=
# XENDIT_SPLIT_RULE_ID=
# Read by the webhook route in Task 7, which must extend the production guard in
# selectPaymentProvider() to cover it — nothing reads it yet.
# XENDIT_CALLBACK_TOKEN=

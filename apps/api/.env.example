# Copy to apps/api/.env (gitignored):
#   cp apps/api/.env.example apps/api/.env
#
# The credentials here must match infra/.env, which is what actually
# initialises the Postgres container. Full local setup from a fresh clone:
#
#   1. cp infra/.env.example infra/.env       # then edit POSTGRES_PASSWORD
#   2. cp apps/api/.env.example apps/api/.env # set the same password below
#   3. docker compose -f infra/docker-compose.yml up -d
#   4. cd apps/api && bun run db:migrate
#   5. bun test                               # also works from the repo root
#
# If you change POSTGRES_PASSWORD after the volume already exists, Postgres
# will NOT pick it up — credentials are only applied on first initialisation.
# Recreate the volume (destroys local data) with:
#   docker compose -f infra/docker-compose.yml down -v
DATABASE_URL=postgres://diudara:change_me@localhost:5432/diudara
PORT=3000

# REQUIRED, and not optional in the way it looks. Nothing else in this
# repository sets NODE_ENV — Bun does not default it, there is no `start`
# script, no Dockerfile, and no API service in infra/docker-compose.yml — so
# without this line `process.env.NODE_ENV` is `undefined`.
#
# bootstrap() treats NODE_ENV as an ALLOWLIST: the fake payment adapter and an
# absent XENDIT_CALLBACK_TOKEN are permitted ONLY when it is exactly
# "development" or "test" (`bun test` sets "test" itself). Every other value —
# including unset, "staging", "prod" and "PRODUCTION" — refuses to start unless
# Xendit is fully configured. That is deliberate: an unrecognised value must
# fail CLOSED rather than silently taking fake money.
#
# On a real deployment, set the real Xendit variables below; do NOT set
# NODE_ENV=development there to make the error go away.
NODE_ENV=development

# Signing secret for creator session JWTs. Generate your own:
#   openssl rand -base64 32
# The API refuses to start if this is unset, shorter than 32 characters, or
# still the placeholder value below — every creator session depends on this one
# key, and a weak HS256 secret is brute-forceable offline from a single token.
JWT_SECRET=change_me_to_a_long_random_string

# Xendit. Unset selects the fake payment adapter, which is permitted ONLY when
# NODE_ENV is exactly development or test (all tests rely on it). For every other
# NODE_ENV — including unset — bootstrap() THROWS unless these are set: a
# misconfigured box must not silently take fake payments and write fake-acct-* ids
# into creator.xendit_account_id, which cannot be undone without manual SQL.
# Partial configuration (one set, the other unset) throws in EVERY environment:
# it is never intentional, and it makes an operator believe payments are live.
# XENDIT_SECRET_KEY=
# XENDIT_SPLIT_RULE_ID=
# The static token Xendit sends as the X-CALLBACK-TOKEN header on every webhook.
# It is the ONLY thing authenticating POST /webhooks/xendit — Xendit signs nothing.
# Same thresholds as the two variables above: unset is fine when NODE_ENV is
# development or test (the webhook route then rejects every delivery, so set it if
# you want to exercise that path locally), but bootstrap() THROWS for any other
# NODE_ENV, and throws in EVERY environment if the two keys above are set without
# it — real invoices with no way to authenticate the callback means nobody who pays
# is ever activated. It must also be at least 32 characters, exactly like
# JWT_SECRET above and for the same reason. Copy the value from
# Settings → Developers → Webhooks in the Xendit dashboard. The token the test
# suite uses is committed to this repository, so it is rejected here too.
# XENDIT_CALLBACK_TOKEN=

# Messaging providers — how a paying member actually receives access.
#
# TELEGRAM_BOT_TOKEN is issued by @BotFather (free and instant) and is what
# TelegramBotAdapter uses to create single-use, expiring invite links and to
# remove members. FONNTE_API_TOKEN is what FonnteWhatsAppAdapter uses to send the
# member the WhatsApp message carrying that link. WhatsApp is NOTIFICATION-ONLY:
# it cannot gate group access, and FonnteWhatsAppAdapter throws rather than
# pretending otherwise — see the WHY NOTIFY ONLY note in its source.
#
# Same rule as the Xendit variables above, and for the same reason: leaving one
# unset selects FakeMessagingAdapter, which records sends instead of making them,
# and that is permitted ONLY when NODE_ENV is exactly development or test. For
# every other value — INCLUDING unset, "staging", "prod" and "PRODUCTION" — the
# selector THROWS, because a box that looks like it is inviting paying members
# and is only writing to an array is the worst failure mode in this phase: the
# member appears granted and is not.
#
# The selection happens where the sending happens, in the outbox worker
# (apps/worker, Phase 4 Task 5) — the API process itself never calls a messaging
# provider, it only writes the outbox row. Both tokens are bearer credentials:
# the Telegram one is part of every Bot API request PATH, so neither adapter ever
# puts a URL, a request, or a response body into an error message.
# TELEGRAM_BOT_TOKEN=
# FONNTE_API_TOKEN=

# Base URL of the PUBLIC web app (apps/web), used to build the
# success_redirect_url Xendit sends the payer to after paying:
#   <APP_BASE_URL>/c/<slug>/status/<subscriptionId>
# Without it the confirmation page is unreachable — a member who pays is left on
# Xendit's own receipt with no way back. Defaults to the Vite dev server below;
# set it to the real https:// origin on a deployment. No trailing slash.
APP_BASE_URL=http://localhost:5173

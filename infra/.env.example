# Copy to infra/.env and fill in. infra/.env is gitignored — it holds real secrets
# and is created by hand, once, per machine. scripts/deploy.sh never touches it.

POSTGRES_USER=diudara
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=diudara

# Host-side port. NOT 5432 on this machine: the carreel-driver-db container already
# binds 0.0.0.0:5432, so 5432 here makes `docker compose up` fail with a port clash.
# Must match the port in backend/.env's DATABASE_URL.
POSTGRES_PORT=5443

# Must match backend/.env's PORT (and the proxy_pass port in deploy/nginx/).
API_PORT=3004

# Shared secret MediaMTX sends back to the API on every auth/lifecycle webhook.
# Must match backend/.env's MEDIAMTX_WEBHOOK_SECRET. `openssl rand -hex 32`.
MEDIAMTX_WEBHOOK_SECRET=change_me_in_production

# This server's PUBLIC IP(s), comma-separated. Correctly EMPTY when the publishing
# browser and this server are the same machine (local dev). When they are not,
# leaving it empty makes remote WebRTC publishing fail silently — see the warning
# the mediamtx container prints on every start.
MEDIAMTX_WEBRTC_ADDITIONAL_HOSTS=

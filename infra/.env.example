# Copy to infra/.env (gitignored) before starting the stack:
#   cp infra/.env.example infra/.env
#
# Compose reads infra/.env automatically because the compose file lives here.
# All three values are required — the stack refuses to start without them.
#
# Choose a real password. Keep apps/api/.env's DATABASE_URL in sync with
# whatever you set here:
#   DATABASE_URL=postgres://<POSTGRES_USER>:<POSTGRES_PASSWORD>@localhost:<POSTGRES_PORT>/<POSTGRES_DB>
#
# Note: POSTGRES_USER/PASSWORD/DB only take effect on FIRST start, when the data
# volume is initialised. To change credentials on an existing local setup you
# must drop the volume (destroys local data):
#   docker compose -f infra/docker-compose.yml down -v
POSTGRES_USER=diudara
POSTGRES_PASSWORD=change_me
POSTGRES_DB=diudara

# Host port for the loopback-only binding. Change if 5432 is already taken.
POSTGRES_PORT=5432

# Task 6: MediaMTX's copy of MEDIAMTX_WEBHOOK_SECRET. MUST be the exact same
# value as apps/api/.env's MEDIAMTX_WEBHOOK_SECRET — the same rule as
# POSTGRES_PASSWORD/DATABASE_URL above, and for the same reason: two copies
# of one secret are two things to keep in sync, and a mismatch here doesn't
# fail loudly, it 401s every publish and every read. docker-compose.yml uses
# this to build both MTX_AUTHHTTPADDRESS (a query parameter — authHTTPAddress
# has no way to send a header) and the container's own environment (read by
# mediamtx.yml's runOnOnline/runOnOffline curl commands, which send it as a
# header instead, since those are genuine shell commands). Generate with:
#   openssl rand -hex 32
#
# A THIRD COPY EXISTS, as of Task 9: infra/nginx/live-hls.conf.template's
# `${MEDIAMTX_WEBHOOK_SECRET}` placeholder — rendered at deploy time (plain
# `envsubst`, never committed as plaintext) so nginx's `auth_request`
# subrequest can authenticate to apps/api the same way MediaMTX's own hooks
# do. KEEP ALL THREE IN SYNC: this file's value, apps/api/.env's value, and
# whatever value the deploy's envsubst step renders into the nginx config.
# THE FAILURE MODE IF THE NGINX COPY DRIFTS IS WORSE THAN THE OTHER TWO,
# AND SILENT: `/webhooks/mediamtx/auth-request` answers 401, nginx's
# `auth_request` treats a 401 as an ordinary access denial (not an error —
# nothing is logged beyond the routine deny, and the request never reaches
# a route handler in apps/api that could log anything either), and EVERY
# viewer sees "Tautan sudah tidak berlaku" — indistinguishable from an
# expired token, with no alarm anywhere. If every viewer suddenly can't
# watch anything at once while the creator insists the broadcast is
# running, this three-way mismatch is the first thing to check. See
# CONTRIBUTING.md's "Live streaming (MediaMTX)" section for the full
# reasoning.
MEDIAMTX_WEBHOOK_SECRET=change_me

# Task 1 (browser publishing / WHIP): the server's public IP(s), comma
# separated if more than one. NOT a secret — this is optional, unlike
# MEDIAMTX_WEBHOOK_SECRET above, and only load-bearing once a creator's
# browser and this server are on DIFFERENT machines (every real deployment).
# It becomes MediaMTX's `webrtcAdditionalHosts` (see infra/mediamtx.yml's
# own comment on that key for the full reasoning): without it, a server
# behind a cloud provider's NAT hands out only its LOCAL interface address
# as an ICE candidate, which a remote browser cannot route to — WebRTC
# negotiates but no media ever connects, silently, on either side. Leave
# unset for local testing where the publishing browser and MediaMTX run on
# the SAME machine (the local interface candidate already connects there).
# On a real VPS, set it to that VPS's public IP.
MEDIAMTX_WEBRTC_ADDITIONAL_HOSTS=

# The `location` blocks the real VPS's PUBLIC nginx needs to serve live
# streaming: browser publishing in (`^~ /whip/u/`), HLS playback out
# (`^~ /u/`), the internal `auth_request` upstream playback runs through, and
# a `deny all` keeping MediaMTX's own webhook endpoints off the public
# surface. FOUR LOCATIONS, ONE WORLD.
#
# Playback re-authorises EVERY HLS request against apps/api instead of
# trusting MediaMTX's own read-auth cache (which authorises once per viewer
# SESSION, not once per request — see mediamtx-webhooks.ts's `/auth-request`
# docstring and task-9-report.md for the empirical finding this responds to),
# and rewrites the PUBLIC path (which carries only a `user_stream` id, never
# the stream key) onto MediaMTX's unchanged INTERNAL path (which still carries
# the key) after that re-authorisation succeeds.
#
# RETIRE-TELEGRAM TASK 7 REMOVED THE COMMUNITY HALF: `^~ /live/`, `^~ /whip/`,
# and the `= /_internal/mediamtx-auth-request` upstream only `/live/` ever
# called. They were dead — Task 6 had already narrowed apps/api's
# `parseStreamPath` to the `u` namespace alone, so a `/live/` read was refused
# by the auth subrequest and a `/whip/` publish by MediaMTX's own hook — and
# they were dead in a way that mattered: `/live/` was the ONLY remaining
# location that would forward a CLIENT-SUPPLIED `X-Mtx-Stream-Id` into an
# `auth_request`, protected by a single `proxy_set_header X-Mtx-Stream-Id "";`
# line whose own comment justified itself by a both-or-neither rule Task 6 had
# already deleted. Removing the location removed the reachable path rather
# than the guard on it. See the internal auth location at the bottom of this
# file for that argument in full.
#
# **THAT REMOVAL IS UNVERIFIED HERE.** This project has no way to run nginx,
# so it is reasoned from nginx's documented location-selection algorithm —
# removing a SHORTER `^~` prefix cannot change selection for a URI that
# matches a longer one, and no surviving location shares a prefix with either
# deleted one — and must be checked with `nginx -t` plus a real playback and a
# real publish at deploy time. See CONTRIBUTING.md's pre-deploy checklist.
#
# THIS IS A FRAGMENT, NOT A STANDALONE nginx SERVER — it is `location`
# blocks, meant to be pasted (or `include`d, after rendering the one
# templated value below) INSIDE the real public HTTPS server block that
# already serves this app's SPA and API paths on :443. It is NOT its own
# `server { listen ...; }` — the real deployment has exactly one public
# nginx front door, not a second listener on a second port. (An earlier
# version of this file WAS a standalone `server { listen 8443; }` — that
# was this task's own local Docker-based proof harness, committed by
# mistake as if it were the deployable artifact. Fixed: this file is now
# the thing meant to actually ship.)
#
# FIX 2 (final whole-branch review, Important): "fixed" above was true of
# the FRAGMENT's own contents, but nobody had actually PROVEN the shipped
# file — copied verbatim into a real `server {}` block, reloaded, driven
# with real requests — works. The Task 9 behavioural proof used a
# DIFFERENT artifact (the standalone 8443 harness with
# host.docker.internal targets), verified via `nginx -t`, which is SYNTAX,
# not behaviour. The final whole-branch review's own verification instead
# built a real `server { listen 8443 ssl; ... include
# live-hls.conf.template; }` (self-signed cert, real MediaMTX, real
# apps/api, envsubst-rendered exactly like a real deploy would) and drove
# the identical checks THROUGH that server block — see
# `final-fix-report.md` for the transcript. Only after that did this file
# get treated as proven.
#
# TWO TEMPLATED VALUES: `${MEDIAMTX_WEBHOOK_SECRET}` and `${API_PORT}`.
# Render BOTH — an unrendered `${API_PORT}` is an nginx syntax error, which is
# the failure you want, and `nginx -t` will say so before anything reloads:
#
#   API_PORT=3004 MEDIAMTX_WEBHOOK_SECRET=... \
#     envsubst '${MEDIAMTX_WEBHOOK_SECRET} ${API_PORT}' \
#     < live-hls.conf.template > /etc/nginx/snippets/live-hls.conf
#
# The original note, on the secret, follows and applies to both. Render it with
# whatever secrets-injection mechanism the real deploy uses before
# `include`ing this file — plain `envsubst 'MEDIAMTX_WEBHOOK_SECRET' <
# live-hls.conf.template > /etc/nginx/snippets/live-hls.conf` is enough for
# a bare-VPS nginx (the documented deployment — see below). If this nginx
# is ever run inside a container instead (NOT how this project documents
# it today), the official nginx image's own `docker-entrypoint.d`
# templating works too, but ONLY with `NGINX_ENVSUBST_FILTER=
# MEDIAMTX_WEBHOOK_SECRET` explicitly set — an unfiltered envsubst replaces
# every `$name`-shaped token in this file from the process environment,
# which would silently blank out nginx's OWN variables below
# (`$request_uri`, `$host`, `$mtx_stream`, `$mtx_ukey`, ...) the moment any of
# those names ALSO happened to match an environment variable.
#
# THE DOCUMENTED DEPLOYMENT IS BARE-METAL, NOT CONTAINERISED — this is why
# every `proxy_pass` target below is `127.0.0.1`, not a Docker hostname.
# nginx itself is not a service in `infra/docker-compose.yml` at all (that
# file only runs Postgres and MediaMTX); it runs directly on the VPS host,
# same as `apps/api`. From there, `127.0.0.1:8888` correctly reaches
# MediaMTX's HLS port (docker-compose maps it to the HOST's own loopback,
# not to a container-network address), and `127.0.0.1:${API_PORT}` reaches
# `apps/api` (also running directly on the host, not containerised — there is
# no `api` service in docker-compose.yml to be one). That port is `PORT` in
# `apps/api/.env` and is 3004 on the real VPS; this text said 3000 until
# 2026-08-26, which is a port an unrelated app occupies on that same box.
#
# IF YOU EVER CONTAINERISE THIS nginx INSTEAD (not the documented path,
# but worth recording since it changes both proxy_pass targets): a
# container's own loopback is not the host's. This task's own local proof
# needed nginx running as a Docker container (there is no other way to
# stand up nginx in this project's sandboxed dev environment), and BOTH
# `127.0.0.1` targets below had to become the container's view of the host
# — `host.docker.internal`'s resolved IPv4 address specifically, because a
# `resolver`-dependent hostname lookup for `host.docker.internal` failed
# without one, and the container used was not on a Docker-managed network
# with the embedded DNS server that resolver needs (see task-9-report.md
# for the exact failure and the working substitution). This is a real,
# tested variant, but it is NOT what ships — recorded here only so a future
# change to a containerised nginx does not have to rediscover it.
#
# OPERATIONAL COUPLING THIS INTRODUCES, WORTH KNOWING BEFORE DEPLOYING:
# every single HLS request now blocks on a live round trip to `apps/api`.
# An `apps/api` restart (a deploy, a crash, `bun --hot` picking up a file
# change) now stalls every in-flight viewer for as long as the timeouts
# below allow, where before Task 9 an API restart had NO effect on
# already-playing viewers at all (MediaMTX's own cache kept serving them).
# This is the intended trade — see task-9-report.md §1 for why the
# alternative (MediaMTX's own per-session cache) is a real security gap —
# but it is a genuine new coupling, not a free change.

# NOT IN THIS FRAGMENT, BUT REQUIRED ON THE SAME SERVER BLOCK — the images
# phase's final whole-branch review, Important 2. `POST /users/media`
# accepts a 10 MB photo and an ordinary phone camera produces 2-5 MB, while
# nginx's DEFAULT `client_max_body_size` is 1 MB. A box left on the default
# refuses nearly every real upload with nginx's own 413 page, which
# `apps/api` never sees and never logs. The one line —
#
#     client_max_body_size 12m;
#
# — belongs on the `location /users/` block (or the enclosing `server`)
# that proxies this app's API, and that block is NOT in this repository:
# this file is only the /u/, /whip/u/, internal-auth and webhook-deny
# locations. It is
# written up as its own pre-deploy step in CONTRIBUTING.md ("Pre-deploy
# checklist: photo uploads"), with a curl that verifies it through the
# public origin. It is deliberately NOT declared here: a directive in the
# wrong location block would apply to HLS segment requests and to nothing
# that uploads anything.

# FIX 3 (final whole-branch review, Important): "/webhooks/mediamtx/ is
# never on the public surface" was, until this block existed, a claim
# about what THIS file does not contain — never a guard against whatever
# ELSE the same server block proxies. `/webhooks/xendit` MUST be publicly
# reachable (Xendit calls it from the internet — `/webhooks/telegram`, which
# this paragraph used to name alongside it, went with retire-telegram Task 2),
# so the ordinary way to wire that is a
# single `location /webhooks/ { proxy_pass http://127.0.0.1:3000; }` — and
# `/webhooks/mediamtx/*` sits directly under that same prefix. Without an
# explicit guard, `POST /webhooks/mediamtx/auth?secret=...` and
# `GET /webhooks/mediamtx/auth-request` become PUBLICLY REACHABLE by
# default, writing `MEDIAMTX_WEBHOOK_SECRET` into apps/api's access log on
# every call (the secret travels as a query parameter on `/auth` — see
# that route's own docstring for why) and letting a stranger probe the
# `/auth`/`/auth-request`/`/lifecycle` endpoints directly.
#
# `location ^~ /webhooks/mediamtx/` — a PREFIX location (not a regex),
# `deny all;` inside it. Two independent reasons this wins over whatever
# else the server block proxies, so ORDER IN THE FILE DOES NOT MATTER for
# this location the way it would for a `~` regex location (see the `^~ /u/`
# location below for the case where it DOES matter and how this file
# avoids it):
#   1. `/webhooks/mediamtx/` (18 characters) is a LONGER, more specific
#      prefix than `/webhooks/` (10 characters) or `/` — nginx's own
#      location-selection rule picks the LONGEST matching prefix among
#      plain prefix locations, independent of `^~` and independent of
#      where either location appears in the file.
#   2. `^~` additionally means: once this is the longest matching prefix,
#      nginx never even evaluates any REGEX (`~`/`~*`) location that might
#      otherwise have matched `/webhooks/mediamtx/...` with higher
#      priority than a plain `/webhooks/` prefix would.
# Together: no matter what a real deploy's existing `/webhooks/` (or a
# broader `/` SPA fallback) location looks like, or where in the file it
# is declared, this one wins for anything under `/webhooks/mediamtx/`.
# Paste this block ANYWHERE in the server block — the ordering note that
# matters in this file is on the `^~ /u/` location below, not this one.
location ^~ /webhooks/mediamtx/ {
    deny all;
}

# THE BROWSER-PUBLISH (WHIP) LOCATION — the ingest half of this file, and
# the only one of the four locations here with NO `auth_request`.
#
# WHAT WHIP IS, CONFIRMED AGAINST A LIVE MEDIAMTX SERVER RATHER THAN ASSUMED
# FROM DOCS (browser-publishing phase, Task 1):
# `http://<host>:8889/<path>/whip` is MediaMTX's actual WHIP ingest url — a
# browser POSTs its SDP offer there. That is a DIFFERENT url from MediaMTX's
# own browser publish PAGE (`/<path>/publish`, an HTML page whose own
# JavaScript is what POSTs to `/whip`). See CONTRIBUTING.md's "Browser
# publishing (WebRTC / WHIP)" section for the full transcript this location's
# shape was verified against, including the real `201 Created` / SDP-answer
# body / ICE negotiation it carries unmodified.
#
# NO `auth_request` HERE, DELIBERATELY — unlike the `/u/` read location below.
# A publish is authorised by MediaMTX's OWN `authHTTPAddress` call straight to
# apps/api's `/webhooks/mediamtx/auth`, never through this nginx at all (see
# infra/mediamtx.yml) — the SAME gate RTMP publishing already goes through,
# and the design's own explicit constraint: no second credential, no second
# auth path. This location's only job is carrying the WHIP SIGNALLING bytes
# across the one hop Cloudflare's TCP-only proxy can actually carry (nginx on
# 443); the media itself never touches nginx at all, see
# webrtcLocalUDPAddress in infra/mediamtx.yml.
#
# WHY `/whip/u/` IS ITS OWN PREFIX AND NOT NESTED UNDER `/u/`. MediaMTX's own
# WHIP url shape is `/u/<streamKey>/whip[/<sessionId>]` — literally UNDER the
# `/u/` prefix the read location below owns as a `^~` PREFIX location. Per
# nginx's own location-selection algorithm (cited in full on that location), a
# `^~` prefix location, once selected as the longest matching prefix, makes
# nginx skip EVERY regex location for that request — so a `~ ^/u/(.+)/whip$`
# location placed anywhere else in this file, in any order, would NEVER be
# reached. The only way to give WHIP requests different handling than HLS
# reads without touching that read location's security-critical
# `auth_request` logic at all is a prefix that does not literally start with
# "/u/" — "/whip/" doesn't (nginx's longest-PREFIX rule requires an exact
# literal-character match, and "/whip/" / "/u/" share no common prefix beyond
# "/"), so this location and `/u/` below never compete for the same request,
# and this file keeps the same "no regex, no ordering question" property the
# read location's own comments establish.
#
# THE PUBLIC SHAPE IS `<base>/whip/u/<streamKey>[/<sessionId>]`, built by
# `MediaMtxAdapter.createSession`. The `u/` segment sits AFTER `/whip/` rather
# than before it for a reason that is now purely historical, and is recorded
# because the shape is DEPLOYED: the community world's WHIP url was the bare
# `<base>/whip/<key>`, proven against a real MediaMTX and a real browser
# publish and frozen by that proof, so Phase 7 gave the user world the extra
# segment instead of renaming the community one. Retire-telegram Task 7
# deleted the community `^~ /whip/` location; this shape stays, because
# changing it means a coordinated config-and-code change with nothing to gain.
#
# THE REWRITE, BOTH DIRECTIONS: the public url is one path segment SHORTER
# than MediaMTX's own `/u/<streamKey>/whip[/<sessionId>]`, since the fixed
# "whip" text moved from a middle segment to the prefix. `$whip_ukey` /
# `$whip_usession` below capture the two dynamic pieces from the public url
# and `proxy_pass` rebuilds MediaMTX's own shape from them. WHIP's own
# protocol is what makes the SECOND direction necessary: MediaMTX answers the
# initial POST with `201 Created` and a `Location` header naming the new
# session resource — confirmed with a real POST against a real server — and
# that header is MediaMTX echoing back the INTERNAL path it received, the same
# class of leak the read location's own `proxy_redirect` exists to fix for
# HLS's cookie-check redirect. `proxy_redirect` here does the identical job:
# it rewrites that `Location` back to the public `/whip/u/<key>/<sessionId>`
# shape before nginx returns it, so the browser's own WHIP client — which
# resolves `Location` against the url it already has — issues its later
# PATCH/DELETE calls back at THIS location instead of a url nginx never
# proxies.
#
# `access_log off` — REQUIRED: the STREAM KEY travels in this url's path,
# exactly like RTMP's `rtmpUrl` already does. A creator legitimately owns this
# credential (it is the PUBLISH side, not the read side `/u/` protects), but
# nginx's own access log on disk is still not the place for it to sit in
# plaintext — the identical reasoning `/u/`'s own `access_log off` applies to
# the watch token.
#
# THE ERROR LOG CARRIES THIS KEY ANYWAY, ON THE MOST ORDINARY FAILURE THERE IS
# — found running this for real, with MediaMTX stopped:
#     connect() failed (111: Connection refused) while connecting to upstream,
#     ... upstream: "http://127.0.0.1:8889/u/<streamKey>/whip"
# The stream key appears TWICE in that one line (the upstream URL nginx tried,
# and the original request URI nginx also logs alongside it) — once per failed
# attempt. Triggered by MediaMTX being unreachable, which `scripts/deploy.sh`
# causes on every single redeploy, however briefly, by restarting the MediaMTX
# container while nginx keeps running. `access_log off` above keeps this out
# of the ACCESS log exactly as designed; it does nothing for the ERROR log.
# See the `/u/` location for why this project accepts that trade rather than
# raising nginx's error-log threshold, and for the consequence both locations
# share: **this server's nginx error log must be treated as a secret-bearing
# file** — one file, two different secrets (a stream key here, a watch token
# there), the same handling required for both.
location ^~ /whip/u/ {
    set $whip_ukey "";
    set $whip_usession "";
    # $request_uri is RAW, not percent-decoded — so this capture, and the
    # proxy_redirect below that rebuilds MediaMTX's internal path from the same
    # $whip_ukey, are only correct as long as a stream key can never contain a
    # character that would decode differently from its raw form. True today
    # because `newStreamKey` (streaming-provider.port.ts) only ever mints
    # 32-char lowercase hex, but NOT enforced here — a future key format with,
    # say, a literal `/` would need this assumption re-checked, not just this
    # comment updated.
    if ($request_uri ~ "^/whip/u/([^/?]+)(/[^/?]+)?") {
        set $whip_ukey $1;
        set $whip_usession $2;
    }

    access_log off;

    proxy_hide_header WWW-Authenticate;

    proxy_pass http://127.0.0.1:8889/u/$whip_ukey/whip$whip_usession$is_args$args;
    proxy_redirect /u/$whip_ukey/whip/ /whip/u/$whip_ukey/;
    proxy_set_header Host $host;
    proxy_http_version 1.1;
    proxy_set_header Connection "";
}

# THE HLS READ LOCATION — every viewer's manifest and every segment, each
# one re-authorised against apps/api rather than against MediaMTX's own
# read-auth cache (which authorises once per viewer SESSION, not once per
# request — see mediamtx-webhooks.ts's `/auth-request` docstring for the
# empirical finding that motivated this whole file).
#
# THE PUBLIC PATH IS `/u/<streamId>/...` — a `user_stream` row id, NEVER its
# stream key. `GET /streams` (apps/api's `userStreamPlaybackPath`) publishes
# exactly this, and it is PUBLIC: signed in or not, anyone can list who is
# live. Putting `createSession`'s key-bearing `hlsPlaybackPath` on that
# listing would hand every reader every creator's PUBLISH credential. So the
# public URL names an id, the auth subrequest turns it into a key, and this
# location rewrites onto MediaMTX's unchanged internal `u/<streamKey>` path.
#
# MediaMTX was never taught about stream ids. It only ever sees `u/<streamKey>`
# — the path a creator's OBS or browser actually published to.
#
# `^~`, NOT A `~` REGEX LOCATION, and this is the most security-critical line
# in the file. Regex (`~`) locations are evaluated in SOURCE ORDER, and the
# FIRST one that matches wins — not the most specific one. A pre-existing
# regex location elsewhere in the real server block matching something as
# ordinary as `\.(m3u8|ts)$` (a plausible "cache my static/streaming assets"
# catch-all, or part of an SPA's own asset-serving rules) would, if it
# happened to be declared EARLIER in the file, intercept every HLS request
# with NO `auth_request` at all — a silent, total bypass, and nothing about
# `nginx -t` or a casual read of this file would reveal it. `^~` sidesteps the
# ordering question entirely rather than merely documenting it: prefix
# locations are found FIRST, tracking the LONGEST match, and if THAT
# longest-matching prefix location carries `^~`, nginx uses it immediately
# and — per nginx's own documented location-selection algorithm — NEVER
# EVALUATES ANY REGEX LOCATION AT ALL, regardless of source order or how those
# regexes are written. Not "first one wins", but "the regex phase never runs"
# for this path. VERIFIED, not merely cited: a `location ~ \.(m3u8|ts)$
# { return 200 "INTERCEPTED..."; }` declared BEFORE this include still left
# every `/u/...`-shaped request going through `auth_request`, while the same
# regex did intercept an `.m3u8` path outside the prefix — see
# `final-fix-report.md` for the transcript, captured for the community
# location this one is the surviving twin of.
#
# (That guarantee assumes no OTHER `^~` or exact-match `=` location shares
# this prefix with equal or greater specificity — grep the real server block
# for `^~ /u` and `location = /u` before pasting, same as any config change.)
#
# `/u/` IS A SHORT, GENERIC PREFIX — worth one sentence of its own. Anything
# else the real server block wants to serve under `/u/...` (a vanity profile
# URL, say) would be swallowed by this location. This app's own user-facing
# profile route is `/@<handle>`, not `/u/<handle>`, so nothing collides today;
# a future route under `/u/` would have to be declared as a longer `^~` prefix
# or moved.
#
# THE CAPTURE, WITHOUT A REGEX LOCATION: `^~` locations cannot carry named
# regex captures themselves (that syntax belongs to `~` locations only — the
# thing this file deliberately avoids). The stream id and the rest of the
# request path are captured instead with an `if` block matching `$request_uri`
# — a well-known, if inelegant, nginx idiom for exactly this: getting regex
# captures inside a prefix location nginx will always reach. `if` here is safe
# (the usual "if is evil" warnings are about `if` combined with
# `return`/`rewrite ... last` producing surprising control flow; this `if`
# only ever runs `set`, which has none of those hazards).
#
# `$request_uri` IS RAW, NOT PERCENT-DECODED, so this capture is only correct
# as long as a stream id can never contain a character that decodes
# differently from its raw form. True today — the ids are uuids — but not
# enforced here.
location ^~ /u/ {
    set $mtx_stream "";
    set $mtx_urest "";
    if ($request_uri ~ "^/u/([^/?]+)(/[^?]*)?") {
        set $mtx_stream $1;
        set $mtx_urest $2;
    }

    # Captured BEFORE `auth_request` fires — LOAD-BEARING ORDERING, found
    # running this for real: an `auth_request` subrequest does NOT inherit
    # `$args`/`$arg_*`, but a plain `set` variable DOES persist into it. See
    # the internal location below for the empirical trace. The token itself is
    # `user-watch-token.ts`'s.
    set $watch_token $arg_token;
    auth_request /_internal/mediamtx-user-auth-request;

    # The stream key, from the auth subrequest's `X-Stream-Key` RESPONSE
    # header — the ONLY way a value from that subrequest reaches this
    # location. Only ever read after a successful authorisation: if
    # `auth_request` refused, nginx stopped processing before this line.
    auth_request_set $mtx_ukey $upstream_http_x_stream_key;

    # Off for two reasons. FIRST: nginx's default access log format includes
    # the full request line — `GET /u/<streamId>/index.m3u8?token=<...>
    # HTTP/1.1` — which would write the watch token to disk on every single
    # request, a brand new exposure this proxy would otherwise introduce
    # (MediaMTX's own HLS port is loopback-only with no public-facing access
    # log at all). SECOND, and NOT FIXED BY THIS LINE — found running this for
    # real, not assumed: `auth_request` logs "auth request unexpected status"
    # at ERROR level for any subrequest status outside 2xx/401/403 (an API 500,
    # a route drift, an upstream timeout), and nginx's error-log handler
    # independently appends the FULL request line, `?token=...` included,
    # regardless of `access_log off`. Reproduced directly by pointing the
    # internal location at a stub that always returns 500. DELIBERATE CHOICE:
    # this project keeps nginx's error log at its default level rather than
    # raising the threshold to suppress it, because that log is exactly what an
    # operator needs when many viewers break at once — losing it to protect one
    # query parameter is the wrong trade. Consequence, stated plainly:
    # **nginx's error log for this server must be treated as a secret-bearing
    # file**, the same handling `apps/api/.env` already gets. Not only the
    # watch token — the `/whip/u/` location above logs the STREAM KEY to this
    # same file on its own most ordinary failure. (The stream id itself is not
    # a secret; this note is about the token and the key.)
    access_log off;

    proxy_pass http://127.0.0.1:8888/u/$mtx_ukey$mtx_urest$is_args$args;

    # MediaMTX answers a stream's FIRST HLS request with its own `302`
    # cookie-check redirect whose `Location` echoes back the path IT
    # received — which, after the rewrite above, is the INTERNAL, key-bearing
    # one. Without this line that key reaches the viewer's browser through a
    # response header, reintroducing exactly what the id-in-the-URL decision
    # exists to prevent. FOUND RUNNING THIS FOR REAL, NOT ANTICIPATED FROM THE
    # DESIGN — captured against the community twin this location mirrors, whose
    # `/live/` block retire-telegram Task 7 deleted: with the line absent,
    # `curl -D -` against a fresh session showed `Location:
    # http://<host>/live/<REAL STREAM KEY>/index.m3u8?cookieCheck=1&token=...`,
    # and with it present the SAME request's `Location` named the public id
    # instead. `$mtx_ukey`/`$mtx_stream` are the SAME two variables the
    # request-side rewrite above uses, so this can never drift out of sync with
    # it. MediaMTX's sub-manifest URIs — segment and part filenames — are
    # RELATIVE, with no `/u/<key>/` prefix at all, so they need no equivalent
    # rewrite: a relative URI resolves against whatever path the BROWSER
    # already sees, which is always the public one.
    proxy_redirect /u/$mtx_ukey/ /u/$mtx_stream/;
    proxy_set_header Host $host;
    proxy_http_version 1.1;
    proxy_set_header Connection "";
}

# THE `auth_request` UPSTREAM for the read location above. `internal;` —
# reachable only via `auth_request`, never directly from outside this nginx.
# That matches apps/api's own security note: the actual
# `/webhooks/mediamtx/auth-request` endpoint this calls must never be on the
# public surface either, and isn't — the `^~ /webhooks/mediamtx/` block at the
# top of this file denies it, and this subrequest reaches apps/api over
# 127.0.0.1, the same private path MediaMTX's own webhook calls already use.
#
# BOTH AUTHORISATION INPUTS TRAVEL AS HEADERS, NOT QUERY PARAMETERS, and the
# obvious `?streamId=...&token=...` on this subrequest's own URL DOES NOT
# WORK: nginx's `auth_request` subrequest does NOT inherit `$args`/`$arg_*`
# from the request it is authorising. Confirmed with a probe upstream that
# echoed back exactly what the subrequest received — `$arg_token`, read
# directly inside THIS location, came back EMPTY every time, while
# `$request_uri` and the OUTER location's own captures both came back correct.
# The working pattern is the one above: capture the token into a plain
# `set $watch_token $arg_token;` in the OUTER location, BEFORE `auth_request`
# fires — a `set` variable persists into the subrequest the same way a
# regex/`if` capture does, even though `$arg_token` itself does not. See
# task-9-report.md for the full empirical trace, including the config that
# does not work.
#
# `X-Mtx-Event-Id ""` — WHY A HEADER apps/api NO LONGER READS IS STILL SET.
# The route used to serve two worlds and tell them apart by which id header
# arrived: `X-Mtx-Event-Id` named a community `event`, `X-Mtx-Stream-Id` names
# a `user_stream`. Retire-telegram Task 6 deleted the community world and that
# entry point with it, so `X-Mtx-Event-Id` is now read by nothing at all and
# this line has no behaviour left to protect. IT IS KEPT AS HYGIENE, NOT AS A
# GUARD: an `auth_request` subrequest INHERITS the parent request's incoming
# headers and `proxy_set_header` only overrides the fields it NAMES, so
# without this line a client's own `X-Mtx-Event-Id` would be forwarded
# verbatim to apps/api on every read. Nothing reads it today; the line is what
# stops a future re-reader of that header from silently becoming
# client-controlled. Do not treat its removal as free.
#
# `X-Mtx-Stream-Id "$mtx_stream"` IS THE LOAD-BEARING ONE, for the same
# inheritance reason stated in the opposite direction: this location always
# NAMES the field, so whatever id the client attached is always overwritten by
# the one nginx captured from the public request path. A request whose `if`
# regex MISSES (a bare `GET /u/`, so `$mtx_stream` stays empty) still names
# it, and nginx's documented behaviour for `proxy_set_header field "";` is to
# DROP the field — apps/api then sees no id and refuses. `presentId`
# (mediamtx-webhooks.ts) additionally reads an empty or whitespace-only id
# header as ABSENT, so the refusal does not depend on which way a given nginx
# version handles an empty value. A client cannot choose which stream this
# location resolves, and cannot make it resolve one at all without putting the
# id in the URL where the token must match it.
#
# WHY THERE IS NO SECOND, COMMUNITY COPY OF THIS LOCATION. There was one
# (`= /_internal/mediamtx-auth-request`), reached from a `^~ /live/` location,
# and retire-telegram Task 7 deleted both. Its `proxy_set_header
# X-Mtx-Stream-Id "";` line HAD become the only thing stopping a client from
# forging a user-stream id onto a `/live/` URL and having apps/api authorise
# it — so the deletion was made on the structural argument, not on that
# line's own comment, which still described a both-or-neither rule Task 6 had
# removed: a forged inbound id header can only reach apps/api through a
# location that issues an `auth_request`, this is now the ONLY such location,
# and it names both id headers unconditionally. Removing the `/live/` location
# removed the reachable path, not just the guard on it.
location = /_internal/mediamtx-user-auth-request {
    internal;
    access_log off;

    # Bounded, rather than nginx's 60s defaults — an unhealthy apps/api should
    # deny the segment fast rather than hold every in-flight viewer's
    # connection open for a minute each. Not tuned against real traffic; picked
    # to be clearly faster than a human notices a stall as "broken" without
    # being so tight that an ordinary GC pause or a briefly slow query becomes
    # a false refusal.
    proxy_connect_timeout 3s;
    proxy_read_timeout 3s;

    # `${API_PORT}`, NOT a hardcoded 3000. This file said 3000 until 2026-08-26,
    # and on the real VPS `apps/api` listens on 3004 (`PORT` in apps/api/.env)
    # while something ELSE — an unrelated app on the same box — listens on
    # 3000. Pasting this file as written would therefore have sent every watch
    # authorisation, carrying `X-Mediamtx-Secret` below, to a different
    # application. Not a dead port that fails closed: a live one belonging to
    # somebody else, handed the shared secret on every HLS segment request.
    proxy_pass http://127.0.0.1:${API_PORT}/webhooks/mediamtx/auth-request;
    proxy_pass_request_body off;
    proxy_set_header Content-Length "";
    proxy_set_header X-Mediamtx-Secret "${MEDIAMTX_WEBHOOK_SECRET}";
    proxy_set_header X-Mtx-Stream-Id "$mtx_stream";
    proxy_set_header X-Mtx-Event-Id "";
    proxy_set_header X-Watch-Token "$watch_token";
    # Discover's viewer-count sub-project: `$remote_addr` is a connection-level
    # variable, not a header, so it needs an explicit forward the way the API's
    # own `api-proxy.conf.template` already forwards it as `X-Real-IP`. This is
    # the one part of that sub-project NOT YET VERIFIED against a real
    # MediaMTX/nginx box — see mediamtx-webhooks.ts's `/auth-request`
    # docstring and `docs/superpowers/specs/2026-09-12-live-viewer-counts-design.md`.
    # Confirm `X-Client-IP` actually arrives before relying on public-stream
    # viewer counts in production; until then they degrade to one shared
    # identity rather than breaking.
    proxy_set_header X-Client-IP $remote_addr;
}

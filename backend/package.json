{
  "name": "diudara-api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/main.ts",
    "start": "bun src/main.ts",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun src/infrastructure/db/migrate.ts",
    "db:push": "drizzle-kit push",
    "db:seed": "bun src/infrastructure/db/seed.ts",
    "test": "bun test"
  },
  "dependencies": {
    "drizzle-orm": "^0.36.4",
    "hono": "^4.6.13",
    "postgres": "^3.4.5"
  },
  "devDependencies": {
    "@types/bun": "^1.1.14",
    "drizzle-kit": "^0.28.1",
    "typescript": "^5.6.3"
  }
}

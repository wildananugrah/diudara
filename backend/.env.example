# Port 3004 is what deploy/nginx/diudara2.mhamzah.id proxies to. 3000 is taken by
# carreel-grafana on this host and 3005 by crypto-api, so do not "simplify" this to 3000.
PORT=3004

# Host port 5443, NOT 5432: carreel-driver-db already binds 0.0.0.0:5432 on this machine.
# Must match POSTGRES_PORT in infra/.env.
#
# Database is `diudara_app`, NOT `diudara`. The `diudara` database on this volume
# still holds ~180 rows from an earlier backend (tables app_user/community/post,
# plus its own __drizzle_migrations). That backend's source is gone from backend/,
# but its data was left untouched rather than dropped. Drop it deliberately if it
# is confirmed dead; do not point this URL at it.
DATABASE_URL=postgres://diudara_app:diudara_app_dev_password@127.0.0.1:5443/diudara_app

# Replace before exposing this to anything real: `openssl rand -hex 32`
JWT_SECRET=dev_only_insecure_secret_change_me
JWT_EXPIRES_IN=7d

# Comma-separated. Vite dev server origin.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Where uploaded files land. Relative to backend/.
STORAGE_DIR=./storage

# Shared with infra/.env so MediaMTX webhooks can be authenticated.
MEDIAMTX_WEBHOOK_SECRET=dev_only_webhook_secret

# The PUBLIC address a creator's OBS dials in on — this string is handed to a
# human to paste into software on their own laptop, so `localhost` is only right
# when that laptop IS this machine.
#
# SET THIS EXPLICITLY IF THE SITE IS BEHIND A CDN. Blank falls back to
# PUBLIC_URL's hostname, which is wrong whenever that name is proxied:
# diudara2.mhamzah.id resolves to Cloudflare, and Cloudflare forwards HTTP/HTTPS
# only — OBS would dial a Cloudflare edge IP on 1935 and get "Failed to connect
# to server", with nothing reaching this box at all. Use a DNS-only ("grey
# cloud") name or the origin IP, e.g. stream.mhamzah.id -> 103.127.98.119.
# The port is MediaMTX's rtmpAddress in infra/mediamtx.yml — :1935, intentionally
# public, protected by the stream key alone.
MEDIAMTX_RTMP_HOST=
MEDIAMTX_RTMP_PORT=1935

# AI co-builder (Pulse-ID) for creating a community by chat. Optional: leave blank
# and POST /api/ai/community-builder returns 503 while everything else works.
# Get a key at https://openrouter.ai/keys. SERVER-SIDE ONLY — never copy this into
# the frontend or any VITE_* variable, or it ships to every visitor's browser.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini

# Sent to OpenRouter as HTTP-Referer for usage attribution.
PUBLIC_URL=https://diudara2.mhamzah.id
